# Variables de entorno para desarrollo local (copiar a .env.local; nunca subir secretos reales).
# Supabase (requeridas en producción y en el flujo de autenticación)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# URL pública del sitio (enlaces de correo y callbacks)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Opcional: UUIDs de agencias separadas por coma con chat habilitado en piloto
HUBLY_CHAT_PILOT_WORKSPACE_IDS=
